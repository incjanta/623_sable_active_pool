  "state_model": {
    "system_summary": [
      "Borrowers deposit native BNB collateral through BorrowerOperations into ActivePool.",
      "BorrowerOperations updates TroveManager trove structs and mints USDS debt.",
      "TroveManager manages liquidations, redemptions, rewards, and active trove ordering through SortedTroves.",
      "StabilityPool receives USDS deposits, offsets liquidated debt, burns USDS, receives BNB from ActivePool, and pays BNB/SABLE gains.",
      "DefaultPool temporarily holds redistributed liquidation debt/collateral until pending rewards are applied.",
      "CollSurplusPool holds surplus BNB claimable by borrowers.",
      "SystemState supplies live solvency constants and is controlled by TimeLock.",
      "PriceFeed supplies BNB/USD via Pyth primary and Chainlink fallback.",
      "SableStakingV2 accepts SABLE_LP and distributes BNB/USDS/SABLE fee gains."
    ],
