  "behavior": {
    "value_flow": {
      "bnb_ingress": [
        "BorrowerOperations sends borrower collateral to ActivePool during open/add collateral.",
        "DefaultPool sends pending redistributed BNB back to ActivePool.",
        "ActivePool sends liquidation BNB gains to StabilityPool.",
        "Fee/reward paths can leave BNB in SableStakingV2."
      ],
      "bnb_egress": [
        "ActivePool sends collateral to borrowers on withdrawal/close.",
        "ActivePool sends liquidation gas compensation to callers.",
        "ActivePool sends liquidation offset collateral to StabilityPool.",
        "ActivePool sends redemption/surplus BNB to redeemers or CollSurplusPool.",
        "StabilityPool sends BNB gains to depositors or into troves.",
        "SableStakingV2 sends BNB gains to stakers."
      ],
      "usds_flow": [
        "BorrowerOperations mints USDS to borrowers and GasPool.",
        "BorrowerOperations burns USDS on repay/close.",
        "StabilityPool pulls USDS from depositors through USDSToken.sendToPool.",
        "StabilityPool burns USDS during liquidation offset.",
        "StabilityPool returns USDS to depositors on withdrawal.",
        "TroveManager burns USDS during redemption."
      ],
      "sable_and_lp_flow": [
        "CommunityIssuance issues SABLE to StabilityPool reward accounting.",
        "SableStakingV2 tracks staked SABLE_LP and distributes BNB/USDS/SABLE gains.",
        "SABLE_LP pair holds SABLE and WBNB reserves."
      ]
    },
